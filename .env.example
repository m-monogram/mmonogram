# Supabase (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Lead notifications (optional)
# Point to n8n / Make / custom endpoint that forwards to Telegram.
# POST JSON: { channel, text, message, lead: { name, phone, email, car, service, message, source, page, created_at } }
# NOTE: add this host to connect-src in the CSP (vercel.json / netlify.toml),
# otherwise the browser blocks the request.
# Example n8n: https://n8n.example.com/webhook/mmonogram-leads
VITE_LEADS_WEBHOOK_URL=

# Canonical site URL (used for canonical/og:url tags and sitemap generation).
# Must match the domain the site is actually served from, otherwise every page
# declares a canonical on another domain and drops out of the search index.
VITE_SITE_URL=https://mmonogram.lovable.app
